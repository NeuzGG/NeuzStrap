<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10 (1903+) and Windows 11 PC,
         so NeuzStrap runs without installing anything extra. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NeuzStrap</AssemblyName>
    <RootNamespace>NeuzStrap</RootNamespace>
    <ApplicationIcon>Resources\NeuzStrap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.2.0</Version>
    <Product>NeuzStrap</Product>
    <Title>NeuzStrap</Title>
    <Description>A lightweight, potato-PC friendly Roblox launcher</Description>
    <Company>NeuzStrap</Company>
    <Copyright>Copyright (c) 2026 Neuz. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\NeuzStrap.ico" LogicalName="NeuzStrap.ico" />
  </ItemGroup>

</Project>
